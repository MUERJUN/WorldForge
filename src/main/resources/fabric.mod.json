{
	"schemaVersion": 1,
	"id": "worldforge",
	"version": "${version}",
	"name": "WorldForge",
	"description": "Runtime dynamic item engine for Minecraft - create, modify and delete virtual items without restarting the game. v0.2.0: + in-game visual editor (WorldForge Studio) with server-validated protocol.",
	"authors": [
		"MUERJUN"
	],
	"contact": {
		"homepage": "https://github.com/MUERJUN/WorldForge",
		"sources": "https://github.com/MUERJUN/WorldForge"
	},
	"license": "MIT",
	"icon": "assets/worldforge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.worldforge.WorldForge"
		],
		"client": [
			"dev.worldforge.client.WorldForgeClient"
		],
		"fabric-gametest": [
			"dev.worldforge.test.WorldForgeGameTests",
			"dev.worldforge.test.WorldForgeV012Tests",
			"dev.worldforge.test.WorldForgeStudioBusinessTests"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}